---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  folder: string;
  label: string;
}

const { folder, label } = Astro.props;

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/photos/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);

// Photos show in filename order, so name them 01-..., 02-... to control the order.
const photos = Object.entries(modules)
  .filter(([path]) => path.startsWith(`/src/photos/${folder}/`))
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, mod]) => mod.default);
---

{
  photos.length === 0 ? (
    <p class="empty">
      No photos here yet. Add images to <code>src/photos/{folder}/</code> and they will appear after the next build.
    </p>
  ) : (
    <>
      <ul class="gallery">
        {photos.map((img, i) => (
          <li style={`--ratio:${(img.width / img.height).toFixed(4)}`}>
            <Picture
              src={img}
              alt={`${label} photograph ${i + 1}`}
              formats={['webp']}
              widths={[800, 1400, 2000]}
              sizes="(max-width: 820px) 100vw, 55vw"
              quality={82}
              loading={i < 3 ? 'eager' : 'lazy'}
            />
          </li>
        ))}
      </ul>

      <dialog class="lightbox" aria-label="Photo viewer">
        <button class="lb-btn lb-close" type="button" aria-label="Close">&times;</button>
        <button class="lb-btn lb-prev" type="button" aria-label="Previous photo">&#8249;</button>
        <img class="lb-img" alt="" />
        <button class="lb-btn lb-next" type="button" aria-label="Next photo">&#8250;</button>
      </dialog>
    </>
  )
}

<style is:global>
  .gallery li { cursor: zoom-in; }

  .lightbox {
    position: fixed; inset: 0;
    width: 100%; height: 100%;
    max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: rgba(12, 12, 12, 0.95);
  }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox::backdrop { background: transparent; }
  .lb-img {
    display: block; width: auto; height: auto;
    max-width: 94vw; max-height: 92vh; object-fit: contain;
  }
  .lb-btn {
    position: fixed; z-index: 1;
    background: none; border: 0; color: #fff; cursor: pointer;
    font: inherit; line-height: 1; padding: 0.5rem 1rem; opacity: 0.8;
  }
  .lb-btn:hover { opacity: 1; }
  .lb-close { top: 0.5rem; right: 0.75rem; font-size: 2.6rem; }
  .lb-prev, .lb-next { top: 50%; transform: translateY(-50%); font-size: 3.6rem; }
  .lb-prev { left: 0.25rem; }
  .lb-next { right: 0.25rem; }
  body:has(dialog[open]) { overflow: hidden; }
  @media (max-width: 560px) {
    .lb-prev, .lb-next { font-size: 2.6rem; padding: 0.5rem; }
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>('.gallery li'));
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');

  if (dlg && items.length > 0) {
    const big = dlg.querySelector<HTMLImageElement>('.lb-img')!;
    let index = 0;

    // The expanded view uses the largest size the build generated for that photo.
    const largest = (li: HTMLElement) => {
      const set =
        li.querySelector('source')?.getAttribute('srcset') ??
        li.querySelector('img')?.getAttribute('srcset') ??
        '';
      let best = '';
      let bestWidth = -1;
      for (const part of set.split(',')) {
        const [url, desc] = part.trim().split(/\s+/);
        const width = parseInt(desc ?? '0', 10) || 0;
        if (url && width >= bestWidth) {
          best = url;
          bestWidth = width;
        }
      }
      return best || li.querySelector('img')?.currentSrc || '';
    };

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const li = items[index];
      big.src = largest(li);
      big.alt = li.querySelector('img')?.alt ?? '';
      // warm up the next photo so arrowing through feels instant
      new Image().src = largest(items[(index + 1) % items.length]);
    };

    const open = (i: number) => {
      show(i);
      if (!dlg.open) dlg.showModal();
    };

    items.forEach((li, i) => {
      li.tabIndex = 0;
      li.setAttribute('role', 'button');
      li.setAttribute('aria-label', `Expand photo ${i + 1}`);
      li.addEventListener('click', () => open(i));
      li.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(i);
        }
      });
    });

    dlg.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.lb-prev')) show(index - 1);
      else if (target.closest('.lb-next')) show(index + 1);
      else dlg.close();
    });

    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    let startX = 0;
    dlg.addEventListener('touchstart', (e) => { startX = e.changedTouches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>
